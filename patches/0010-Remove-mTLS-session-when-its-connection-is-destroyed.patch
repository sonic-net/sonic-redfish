+    // An event stream has no timer while it is idle: the only one covers a
+    // write in progress, and the pending read reports a clean close but not a
+    // peer that disappears without one (power loss, a dropped link).  Such a
+    // stream stayed open forever, and with it the subscription and the
+    // session it holds, which for a MutualTLS session is the only thing that
+    // removes it from the session store.  TCP keepalive makes the kernel
+    // probe an idle peer and fail the pending read once it stops answering;
+    // an answering peer is left alone however long the stream is quiet.
+    // Detection takes keepAliveIdle + keepAliveCount * keepAliveInterval.
+    static constexpr int keepAliveIdle = 60;
+    static constexpr int keepAliveInterval = 10;
+    static constexpr int keepAliveCount = 6;
+
+    void enableTcpKeepAlive()
+    {
+        auto& socket = boost::beast::get_lowest_layer(adaptor);
+        // Only a real socket has the option; a test stream does not.
+        if constexpr (requires {
+                          socket.set_option(
+                              boost::asio::socket_base::keep_alive(true));
+                          socket.native_handle();
+                      })
+        {
+            boost::system::error_code ec;
+            socket.set_option(boost::asio::socket_base::keep_alive(true), ec);
+            if (ec)
+            {
+                BMCWEB_LOG_WARNING("{} Failed to enable TCP keepalive: {}",
+                                   logPtr(this), ec);
+                return;
+            }
+            int fd = socket.native_handle();
+            if (setsockopt(fd, IPPROTO_TCP, TCP_KEEPIDLE, &keepAliveIdle,
+                           sizeof(keepAliveIdle)) != 0 ||
+                setsockopt(fd, IPPROTO_TCP, TCP_KEEPINTVL, &keepAliveInterval,
+                           sizeof(keepAliveInterval)) != 0 ||
+                setsockopt(fd, IPPROTO_TCP, TCP_KEEPCNT, &keepAliveCount,
+                           sizeof(keepAliveCount)) != 0)
+            {
+                // Keepalive stays on with the system-wide timing
+                BMCWEB_LOG_WARNING("{} Failed to set TCP keepalive timing",
+                                   logPtr(this));
+            }
+        }
+    }
