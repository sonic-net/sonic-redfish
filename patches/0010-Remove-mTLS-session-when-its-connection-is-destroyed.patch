+    // An HTTP/2 connection had no timer at all, so a peer that goes silent
+    // or disappears without closing the socket held the connection, its file
+    // descriptor and its mTLS session until the process restarted.
+    //
+    // Which bound applies depends on whether a request is open:
+    //   - idleTimeout, with no request open: no bytes moved in either
+    //     direction.
+    //   - requestStallTimeout, with a request open: the request made no
+    //     progress.  A stream is opened by the first HEADERS frame, before
+    //     the client has to finish the request, so an open stream cannot be
+    //     told apart from a peer that will never complete it.  Traffic alone
+    //     does not count: PING and WINDOW_UPDATE frames keep bytes moving
+    //     without advancing any request, so a peer could otherwise hold a
+    //     connection open forever at a few bytes a minute.  Progress is a
+    //     new request, request body data, or response data (see
+    //     noteRequestProgress()), so a slow upload, download or handler is
+    //     not cut off, as it is not on HTTP/1.
+    static constexpr std::chrono::seconds idleTimeout{60};
+    static constexpr std::chrono::seconds requestStallTimeout{300};
+    // How long the peer gets to read the GOAWAY before the socket is closed
+    static constexpr std::chrono::seconds goAwayTimeout{5};
+
+    void noteRequestProgress()
+    {
+        lastRequestProgress = std::chrono::steady_clock::now();
+    }
+
+    // streams always holds the control stream (id 0); anything beyond that
+    // is a request that is open.
+    bool hasOpenRequest() const
+    {
+        return streams.size() > 1;
+    }
+
+    std::chrono::steady_clock::time_point idleDeadline() const
+    {
+        if (hasOpenRequest())
+        {
+            return lastRequestProgress + requestStallTimeout;
+        }
+        return lastTraffic + idleTimeout;
+    }
+
+    void armTimerAt(std::chrono::steady_clock::time_point deadline)
+    {
+        // expires_at() cancels a wait that is still pending
+        idleTimer.expires_at(deadline);
+        idleTimer.async_wait(
+            std::bind_front(&self_type::afterIdleTimer, weak_from_this()));
+    }
+
+    // Called whenever bytes were read from or written to the peer
+    void restartIdleTimer()
+    {
+        if (goingAway)
+        {
+            return;
+        }
+        lastTraffic = std::chrono::steady_clock::now();
+        armTimerAt(idleDeadline());
+    }
+
+    static void afterIdleTimer(const std::weak_ptr<self_type>& weakSelf,
+                               const boost::system::error_code& ec)
+    {
+        if (ec == boost::asio::error::operation_aborted)
+        {
+            // Timer was restarted or the connection was closed
+            return;
+        }
+        std::shared_ptr<self_type> self = weakSelf.lock();
+        if (self == nullptr)
+        {
+            return;
+        }
+        if (ec)
+        {
+            BMCWEB_LOG_CRITICAL("{} idle timer failed {}", logPtr(self.get()),
+                                ec);
+            self->close();
+            return;
+        }
+        if (self->idleTimer.expiry() > std::chrono::steady_clock::now())
+        {
+            // The timer was re-armed after this handler had already been
+            // queued; the connection saw traffic and is not idle.
+            return;
+        }
+        self->onIdleTimeout();
+    }
+
+    void onIdleTimeout()
+    {
+        if (goingAway)
+        {
+            BMCWEB_LOG_DEBUG("{} GOAWAY not flushed in time, closing",
+                             logPtr(this));
+            close();
+            return;
+        }
+        // A request may have been opened or closed since the timer was
+        // armed, which changes the bound that applies.
+        std::chrono::steady_clock::time_point deadline = idleDeadline();
+        if (deadline > std::chrono::steady_clock::now())
+        {
+            armTimerAt(deadline);
+            return;
+        }
+        if (hasOpenRequest())
+        {
+            BMCWEB_LOG_WARNING(
+                "{} HTTP/2 request made no progress for {} seconds, closing",
+                logPtr(this), requestStallTimeout.count());
+        }
+        BMCWEB_LOG_DEBUG("{} HTTP/2 connection idle, sending GOAWAY",
+                         logPtr(this));
+        // Tell the peer which streams were processed before closing, so a
+        // request it sent just before the timeout can be retried safely.
+        goingAway = true;
+        if (ngSession.terminateSession(NGHTTP2_NO_ERROR) != 0)
+        {
+            close();
+            return;
+        }
+        armTimerAt(std::chrono::steady_clock::now() + goAwayTimeout);
+        writeBuffer();
+        if (!isWriting)
+        {
+            // Nothing could be queued; no point in waiting
+            close();
+        }
+    }
+
