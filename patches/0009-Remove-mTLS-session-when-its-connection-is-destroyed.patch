+    // An HTTP/2 connection had no timer at all, so a peer that goes silent
+    // or disappears without closing the socket held the connection, its file
+    // descriptor and its mTLS session until the process restarted.
+    //
+    // The connection is closed once no bytes have moved in either direction
+    // for idleTimeout.  While a request stream is open the timer is re-armed
+    // instead, so a handler that is slow to answer is not cut off; but a
+    // stream is opened by the first HEADERS frame, before the client has to
+    // finish the request, so an open stream cannot be told apart from a peer
+    // that will never send another byte.  maxIdlePeriodsWithOpenStreams
+    // therefore bounds how long a completely silent connection is kept, open
+    // streams or not.
+    static constexpr std::chrono::seconds idleTimeout{60};
+    static constexpr unsigned int maxIdlePeriodsWithOpenStreams = 5;
+    // How long the peer gets to read the GOAWAY before the socket is closed
+    static constexpr std::chrono::seconds goAwayTimeout{5};
+
+    void armIdleTimer(std::chrono::seconds timeout)
+    {
+        // expires_after() cancels a wait that is still pending
+        idleTimer.expires_after(timeout);
+        idleTimer.async_wait(
+            std::bind_front(&self_type::afterIdleTimer, weak_from_this()));
+    }
+
+    // Called whenever bytes were read from or written to the peer
+    void restartIdleTimer()
+    {
+        if (goingAway)
+        {
+            return;
+        }
+        idlePeriods = 0;
+        armIdleTimer(idleTimeout);
+    }
+
+    static void afterIdleTimer(const std::weak_ptr<self_type>& weakSelf,
+                               const boost::system::error_code& ec)
+    {
+        if (ec == boost::asio::error::operation_aborted)
+        {
+            // Timer was restarted or the connection was closed
+            return;
+        }
+        std::shared_ptr<self_type> self = weakSelf.lock();
+        if (self == nullptr)
+        {
+            return;
+        }
+        if (ec)
+        {
+            BMCWEB_LOG_CRITICAL("{} idle timer failed {}", logPtr(self.get()),
+                                ec);
+            self->close();
+            return;
+        }
+        if (self->idleTimer.expiry() > std::chrono::steady_clock::now())
+        {
+            // The timer was re-armed after this handler had already been
+            // queued; the connection saw traffic and is not idle.
+            return;
+        }
+        self->onIdleTimeout();
+    }
+
+    void onIdleTimeout()
+    {
+        if (goingAway)
+        {
+            BMCWEB_LOG_DEBUG("{} GOAWAY not flushed in time, closing",
+                             logPtr(this));
+            close();
+            return;
+        }
+        // streams always holds the control stream (id 0); anything beyond
+        // that is a request that is open.
+        if (streams.size() > 1)
+        {
+            idlePeriods++;
+            if (idlePeriods < maxIdlePeriodsWithOpenStreams)
+            {
+                armIdleTimer(idleTimeout);
+                return;
+            }
+            BMCWEB_LOG_WARNING(
+                "{} HTTP/2 connection silent for {} idle periods with a request open, closing",
+                logPtr(this), idlePeriods);
+        }
+        BMCWEB_LOG_DEBUG("{} HTTP/2 connection idle, sending GOAWAY",
+                         logPtr(this));
+        // Tell the peer which streams were processed before closing, so a
+        // request it sent just before the timeout can be retried safely.
+        goingAway = true;
+        if (ngSession.terminateSession(NGHTTP2_NO_ERROR) != 0)
+        {
+            close();
+            return;
+        }
+        armIdleTimer(goAwayTimeout);
+        writeBuffer();
+        if (!isWriting)
+        {
+            // Nothing could be queued; no point in waiting
+            close();
+        }
+    }
+
     void afterDoRead(const std::shared_ptr<self_type>& /*self*/,
                      const boost::system::error_code& ec,
                      size_t bytesTransferred)
