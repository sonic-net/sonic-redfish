+// Owner of a session whose lifetime is that of one client connection (a
+// MutualTLS session created by the TLS handshake).  The session is removed
+// from the SessionStore when the last connection-side reference goes away,
+// whichever object that is: the HTTP/1 connection, the HTTP/2 connection it
+// upgraded to, a WebSocket or SSE connection it handed its socket to, or a
+// request still being handled.
+struct ConnectionBoundSession
+{
+    explicit ConnectionBoundSession(
+        const std::shared_ptr<UserSession>& sessionIn) : session(sessionIn)
+    {}
+
+    ~ConnectionBoundSession()
+    {
+        if (session != nullptr)
+        {
+            SessionStore::getInstance().removeSession(session);
+        }
+    }
+
+    ConnectionBoundSession(const ConnectionBoundSession&) = delete;
+    ConnectionBoundSession(ConnectionBoundSession&&) = delete;
+    ConnectionBoundSession& operator=(const ConnectionBoundSession&) = delete;
+    ConnectionBoundSession& operator=(ConnectionBoundSession&&) = delete;
+
+    std::shared_ptr<UserSession> session;
+};
+
+// Returns a pointer to the same UserSession that additionally shares
+// ownership of a ConnectionBoundSession.  Every copy made from the returned
+// pointer keeps the session in the store; when the last copy is released the
+// session is removed.  The SessionStore's own reference does not count.
+inline std::shared_ptr<UserSession> bindSessionToConnection(
+    const std::shared_ptr<UserSession>& session)
+{
+    if (session == nullptr)
+    {
+        return nullptr;
+    }
+    auto owner = std::make_shared<ConnectionBoundSession>(session);
+    return {owner, session.get()};
+}
