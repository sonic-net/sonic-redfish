 http/http_connection.hpp   |    7 ++++---
 http/routing.hpp           |    5 +++++
 include/authentication.hpp |   12 +++++-------
 src/webserver_run.cpp      |    3 +++
 5 files changed, 19 insertions(+), 10 deletions(-)

